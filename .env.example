# Копия этого файла: cp .env.example .env
# Комментарии стоят ТОЛЬКО на отдельных строках: docker compose и python-dotenv по-разному
# читают комментарий в конце строки, и пустой ключ мог превратиться в непустой.

# ===== App =====
# dev | prod
APP_ENV=dev
# Домен для Caddy в prod (localhost = самоподписанный сертификат)
DOMAIN=localhost
# Подпись cookie-сессий: в prod заменить на длинную случайную строку
SECRET_KEY=change-me
DEMO_USER=demo
DEMO_PASSWORD=change-me
# Защита бюджета API
DEMO_MAX_PROJECTS_PER_DAY=20

# ===== LLM (ProxyAPI, OpenAI-compatible) =====
# Ключ: https://console.proxyapi.ru
PROXYAPI_KEY=
# Проверить: python -m app.cli smoke-llm
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1
# Точные id моделей уточнить командой: python -m app.cli llm-models --filter haiku
LLM_MODEL=claude-haiku-5-5
LLM_FALLBACK_MODEL=deepseek-v4.1-flash
LLM_TIMEOUT_SEC=60

# ===== Images =====
# proxyapi (по умолчанию, тот же ключ, что для LLM, оплата в рублях) | fal (нужен зарубежный платёж)
IMAGE_PROVIDER=proxyapi
# Модель картинок ProxyAPI. Список: python -m app.cli image-models. Цены в каталоге ProxyAPI
PROXYAPI_IMAGE_MODEL=openai/gpt-image-1-mini
# Размеры, которые принимает модель: берётся ближайший по пропорциям, лишнее обрезается
PROXYAPI_IMAGE_SIZES=1024x1024,1024x1536,1536x1024
# low | medium | high. Пусто: параметр не отправляется (его нет у части моделей)
PROXYAPI_IMAGE_QUALITY=low
# ignore | append (дописывать "Avoid: ..." в промпт)
PROXYAPI_IMAGE_NEGATIVE=ignore
# seed в документации ProxyAPI не описан: пока false, иначе возможна ошибка 400
PROXYAPI_IMAGE_SEND_SEED=false
# Цены выбранной модели из каталога ProxyAPI, рубли за 1 млн токенов (для учёта стоимости кадра)
PROXYAPI_IMAGE_PRICE_IN_RUB=0
PROXYAPI_IMAGE_PRICE_OUT_RUB=0
# Фиксированная цена одного кадра в рублях, если API не вернул число токенов
PROXYAPI_IMAGE_COST_RUB=0
IMAGE_CONCURRENCY=4
IMAGE_TIMEOUT_SEC=120
# cover (обрезка) | blur (размытый фон вместо обрезки)
IMAGE_FIT=cover
# Курс для учёта стоимости USD-провайдеров (fal)
USD_RUB=100
# Fal.ai, только если IMAGE_PROVIDER=fal
FAL_KEY=
FAL_MODEL=fal-ai/flux/schnell
FAL_COST_USD_PER_MP=0.003

# ===== TTS =====
TTS_PROVIDER=edge
# Другие голоса: ru-RU-DmitryNeural, en-US-AriaNeural, en-US-GuyNeural, en-US-JennyNeural
TTS_VOICE=ru-RU-SvetlanaNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz
# Пауза между сценами в секундах (FR-3.3)
TTS_SCENE_PAUSE_SEC=0.4
TTS_CONCURRENCY=4

# ===== Infrastructure =====
# В docker-compose REDIS_URL, DATABASE_URL и STORAGE_DIR переопределяются в compose-файлах.
REDIS_URL=redis://redis:6379/0
# Только prod (docker-compose.prod.yml): пароль PostgreSQL
POSTGRES_PASSWORD=change-me
# Для запуска без Docker. В prod: postgresql+psycopg://user:pass@postgres:5432/text2reel
DATABASE_URL=sqlite:///./storage/app.db
STORAGE_DIR=./storage
# Через сколько дней удалять проекты и кэш. 0 отключает очистку (например, пока должно жить демо)
STORAGE_TTL_DAYS=7
# dev: api сам применяет миграции. prod: false, миграции делает сервис migrate
AUTO_MIGRATE=true

# ===== Рендер (FFmpeg) =====
# Переходы, громкость музыки и стиль субтитров задаются в backend/templates/*.json
RENDER_CONCURRENCY=2
RENDER_FPS=30
# Финальное кодирование
FFMPEG_PRESET=veryfast
FFMPEG_CRF=21
# Клипы сцен (Ken Burns) пережимаются при финальной сборке, поэтому быстрый пресет почти не вредит
# качеству и экономит около 20% времени (замеры: docs/METRICS.md)
FFMPEG_CLIP_PRESET=ultrafast
FFMPEG_CLIP_CRF=18
# Во сколько раз кадр увеличивается перед zoompan. 1.5 даёт лишь около 2% скорости, а зум грубее
FFMPEG_UPSCALE=2.0
