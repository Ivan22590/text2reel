# Копия этого файла: cp .env.example .env
# Комментарии стоят ТОЛЬКО на отдельных строках: docker compose и python-dotenv по-разному
# читают комментарий в конце строки, и пустой ключ мог превратиться в непустой.

# ===== App =====
# dev | prod
APP_ENV=dev
# Домен для Caddy в prod (localhost = самоподписанный сертификат)
DOMAIN=localhost
# Подпись cookie-сессий: в prod заменить на длинную случайную строку
SECRET_KEY=change-me
DEMO_USER=demo
DEMO_PASSWORD=change-me
# Защита бюджета API
DEMO_MAX_PROJECTS_PER_DAY=20

# ===== LLM (ProxyAPI, OpenAI-compatible) =====
# Ключ: https://console.proxyapi.ru
PROXYAPI_KEY=
# Проверить: python -m app.cli smoke-llm
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1
# Точные id моделей уточнить командой: python -m app.cli llm-models --filter haiku
LLM_MODEL=claude-haiku-5-5
LLM_FALLBACK_MODEL=deepseek-v4.1-flash
LLM_TIMEOUT_SEC=60

# ===== Images =====
# fal | proxyapi
IMAGE_PROVIDER=fal
FAL_KEY=
FAL_MODEL=fal-ai/flux/schnell
# Для учёта стоимости
FAL_COST_USD_PER_MP=0.003
# Заполнить после сравнения провайдеров (этап 2)
PROXYAPI_IMAGE_MODEL=
# Цена одной картинки у ProxyAPI в рублях, заполнить после сравнения
PROXYAPI_IMAGE_COST_RUB=0
IMAGE_CONCURRENCY=4
IMAGE_TIMEOUT_SEC=90
# cover (обрезка) | blur (размытый фон вместо обрезки)
IMAGE_FIT=cover
# Курс для учёта стоимости USD-провайдеров
USD_RUB=100

# ===== TTS =====
TTS_PROVIDER=edge
# Другие голоса: ru-RU-DmitryNeural, en-US-AriaNeural, en-US-GuyNeural, en-US-JennyNeural
TTS_VOICE=ru-RU-SvetlanaNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz
# Пауза между сценами в секундах (FR-3.3)
TTS_SCENE_PAUSE_SEC=0.4
TTS_CONCURRENCY=4

# ===== Infrastructure =====
# В docker-compose REDIS_URL, DATABASE_URL и STORAGE_DIR переопределяются в compose-файлах.
REDIS_URL=redis://redis:6379/0
# Только prod (docker-compose.prod.yml): пароль PostgreSQL
POSTGRES_PASSWORD=change-me
# Для запуска без Docker. В prod: postgresql+psycopg://user:pass@postgres:5432/text2reel
DATABASE_URL=sqlite:///./storage/app.db
STORAGE_DIR=./storage
# Через сколько дней удалять проекты и кэш. 0 отключает очистку (например, пока должно жить демо)
STORAGE_TTL_DAYS=7
# dev: api сам применяет миграции. prod: false, миграции делает сервис migrate
AUTO_MIGRATE=true

# ===== Рендер (FFmpeg) =====
# Переходы, громкость музыки и стиль субтитров задаются в backend/templates/*.json
RENDER_CONCURRENCY=2
RENDER_FPS=30
# Финальное кодирование
FFMPEG_PRESET=veryfast
FFMPEG_CRF=21
# Клипы сцен (Ken Burns), они пережимаются при финальной сборке
FFMPEG_CLIP_PRESET=veryfast
FFMPEG_CLIP_CRF=20
# Во сколько раз кадр увеличивается перед zoompan (1.5 заметно быстрее)
FFMPEG_UPSCALE=2.0
