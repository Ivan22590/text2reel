# ===== App =====
# Внимание: в docker-compose REDIS_URL, DATABASE_URL и STORAGE_DIR переопределяются в compose-файлах.
APP_ENV=dev                       # dev | prod
DOMAIN=localhost                  # домен для Caddy в prod
SECRET_KEY=change-me              # подпись cookie-сессий
DEMO_USER=demo
DEMO_PASSWORD=change-me
DEMO_MAX_PROJECTS_PER_DAY=20      # защита бюджета API

# ===== LLM (ProxyAPI, OpenAI-compatible) =====
PROXYAPI_KEY=                     # https://console.proxyapi.ru
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1   # проверить smoke-тестом
LLM_MODEL=claude-haiku-5-5        # точный id уточнить в каталоге ProxyAPI
LLM_FALLBACK_MODEL=deepseek-v4.1-flash         # точный id уточнить в каталоге ProxyAPI
LLM_TIMEOUT_SEC=60

# ===== Images =====
IMAGE_PROVIDER=fal                # fal | proxyapi
FAL_KEY=
FAL_MODEL=fal-ai/flux/schnell
FAL_COST_USD_PER_MP=0.003         # для учёта стоимости
PROXYAPI_IMAGE_MODEL=             # заполнить после сравнения (этап 2)
PROXYAPI_IMAGE_COST_RUB=0         # цена одной картинки у ProxyAPI, заполнить после сравнения
IMAGE_CONCURRENCY=4
IMAGE_TIMEOUT_SEC=90
IMAGE_FIT=cover                   # cover | blur (размытый фон вместо обрезки)
USD_RUB=100                       # курс для учёта стоимости USD-провайдеров

# ===== TTS =====
TTS_PROVIDER=edge
TTS_VOICE=ru-RU-SvetlanaNeural    # ru-RU-DmitryNeural, en-US-AriaNeural, en-US-GuyNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# ===== Infrastructure =====
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=change-me        # только prod (docker-compose.prod.yml)
DATABASE_URL=sqlite:///./storage/app.db   # prod: postgresql+psycopg://user:pass@postgres:5432/text2reel
STORAGE_DIR=./storage
STORAGE_TTL_DAYS=7
RENDER_CONCURRENCY=2
FFMPEG_PRESET=veryfast
